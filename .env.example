# --- Backend (label-studio / TaxBook) ---
JWT_SECRET=your-secure-random-secret-here
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=production
HERMES_URL=http://hermes:3002

# Access-token lifetime (JWT). Short-lived; the client rotates via refresh tokens.
JWT_EXPIRES_IN=12h
# Refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# Idempotency keys older than this many hours are purged.
IDEMPOTENCY_TTL_HOURS=24
# Max JSON request body size.
JSON_BODY_LIMIT=10mb

# Seed admin credentials (local bootstrap only - change after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Hermes Agent ---
HERMES_PORT=3002
WORKSPACE_PATH=/workspace
LOG_LEVEL=info

# --- Frontend ---
# No additional env vars needed - configured via web UI
