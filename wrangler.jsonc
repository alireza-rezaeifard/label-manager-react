{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "label-manager",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "label-manager-db",
      "database_id": "0dc06691-fe1a-4d72-a058-249a1e73d7cd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8b173419aa7d4700a190aa6a62a809e8"
    }
  ],
  "vars": {
    "JWT_SECRET": "ff6184132238621647da1ee38688df75cf1c31e4f5937f12dd184ca391de789d"
  }
}
